/* Visual do app = visual do site: os tokens de apps/web/app/globals.css, o botão de pedra do
   acabamento.module.css e as três fontes pixel (Pixelify Sans no texto, VT323 nos números,
   Alkhemikal nos títulos). A tela de referência é 1280×720 (deitada); o PanelSettings escala pela altura. */

:root {
    --ink: #10121a;
    --panel: #1d2230;
    --panel-2: #242a3a;
    --line: rgba(201, 162, 39, 0.28);
    --parchment: #ecdfc0;
    --parchment-dim: #b9ab86;
    --gold: #c9a227;
    --gold-bright: #e8c65a;
    --ember: #c0532f;
    --blood: #8a2b2b;
    --contorno: #1a0b09;

    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/PixelifySans-Regular.ttf");
    -unity-font-definition: initial;
    color: var(--parchment);
    font-size: 20px;
}

.raiz {
    flex-grow: 1;
}

/* ---------- títulos (Alkhemikal: um peso só, nunca negrito) ---------- */

.marca,
.titulo,
.titulo-tela,
.nome,
.toque {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/Alkhemikal.ttf");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

/* ---------- painel com moldura interna dourada ---------- */

.painel {
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
}

.moldura {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    border-width: 1px;
    border-color: rgba(201, 162, 39, 0.12);
    border-radius: 4px;
}

/* ---------- entrada (por cima da porta) ---------- */

.entrada {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.cartao-entrada {
    position: absolute;
    right: 64px;
    top: 50%;
    width: 440px;
    padding: 24px 28px 20px 28px;
    translate: 0 -50%;
    opacity: 1;
    /* margin-top: a subida do cartão quando o teclado do celular abre (AppScreens.AcompanharTeclado). */
    transition-property: opacity, translate, margin-top;
    transition-duration: 0.45s, 0.45s, 0.2s;
    transition-timing-function: ease-out-cubic, ease-out-cubic, ease-out-cubic;
}

.cartao-entrada.escondido {
    opacity: 0;
    translate: 70px -50%;
}

.marca {
    font-size: 44px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.titulo {
    font-size: 26px;
    color: var(--gold-bright);
    margin-bottom: 10px;
}

.campo {
    flex-direction: column;
    margin: 0 0 10px 0;
}

.campo .unity-base-field__label {
    min-width: 0;
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 16px;
    color: var(--parchment-dim);
}

.campo .unity-base-text-field__input {
    min-height: 42px;
    margin: 0;
    padding: 6px 10px;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
    color: var(--parchment);
    font-size: 20px;
    -unity-text-align: middle-left;
}

.campo .unity-base-text-field__input:focus {
    border-color: var(--gold);
}

.erro {
    display: none;
    white-space: normal;
    margin-bottom: 10px;
    padding: 8px 10px;
    background-color: rgba(138, 43, 43, 0.25);
    border-width: 1px;
    border-color: rgba(138, 43, 43, 0.7);
    border-radius: 4px;
    font-size: 16px;
}

.erro.visivel {
    display: flex;
}

.acoes {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
}

.toque {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 44px;
    font-size: 34px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    text-shadow: 3px 3px 0 var(--contorno);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.toque.apagado {
    opacity: 0.45;
}

.toque.escondido {
    opacity: 0;
}

/* ---------- botão de pedra (9-slice da arte do Breno, 40×21) ---------- */
/* Os cortes são a geometria da folha (9/20/11/16) e não mudam sozinhos; a escala é inteira para não
   borrar o pixel. O padding = cortes × escala, para o texto cair no miolo. */

.unity-button.botao {
    margin: 0;
    padding: 18px 40px 22px 32px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("project://database/Assets/RPGLegend/UI/Imagens/botao.png");
    -unity-slice-top: 9;
    -unity-slice-right: 20;
    -unity-slice-bottom: 11;
    -unity-slice-left: 16;
    -unity-slice-scale: 2px;
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/PixelifySans-SemiBold.ttf");
    -unity-font-definition: initial;
    font-size: 20px;
    letter-spacing: 1.6px;
    color: var(--parchment);
    -unity-text-align: middle-center;
    transition-property: color;
    transition-duration: 0.12s;
}

.unity-button.botao:hover,
.unity-button.botao:focus {
    color: var(--gold-bright);
    background-color: rgba(0, 0, 0, 0);
}

.unity-button.botao:active {
    background-image: url("project://database/Assets/RPGLegend/UI/Imagens/botao-apertado.png");
}

.unity-button.botao:disabled {
    opacity: 0.55;
}

.unity-button.link {
    margin: 0;
    padding: 4px 2px 2px 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-radius: 0;
    border-color: rgba(185, 171, 134, 0.6);
    font-size: 17px;
    color: var(--parchment-dim);
}

.unity-button.link:hover,
.unity-button.link:focus {
    color: var(--parchment);
    border-color: var(--parchment);
    background-color: rgba(0, 0, 0, 0);
}

.link-direita {
    align-self: flex-end;
    margin-top: 10px;
}

/* ---------- telas inteiras (menu, personagens) ---------- */

.tela {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ink);
}

.oculto {
    display: none;
}

.menu {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 40px 72px 56px 72px;
}

.brasao {
    width: 420px;
    height: 420px;
    flex-shrink: 0;
    margin-right: 64px;
    background-image: url("project://database/Assets/RPGLegend/UI/Imagens/logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.coluna-menu {
    width: 430px;
}

.ola {
    margin-bottom: 14px;
    font-size: 18px;
    color: var(--parchment-dim);
    -unity-text-align: middle-center;
}

.unity-button.botao-menu {
    margin-bottom: 14px;
    padding: 27px 60px 33px 48px;
    -unity-slice-scale: 3px;
    font-size: 26px;
}

.unity-button.botao-forte {
    color: var(--gold-bright);
}

.canto {
    position: absolute;
    top: 24px;
    right: 32px;
}

.credito {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    font-size: 16px;
    color: var(--parchment-dim);
    -unity-text-align: middle-center;
}

/* ---------- personagens ---------- */

.personagens {
    padding: 32px 52px 36px 52px;
}

.cabecalho {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.titulo-tela {
    font-size: 40px;
    color: var(--gold-bright);
}

.subtitulo {
    font-size: 17px;
    color: var(--parchment-dim);
}

.estado {
    display: none;
    white-space: normal;
    margin-bottom: 12px;
    font-size: 18px;
    color: var(--parchment-dim);
}

.estado.visivel {
    display: flex;
}

.estado.falha {
    padding: 8px 12px;
    background-color: rgba(138, 43, 43, 0.25);
    border-width: 1px;
    border-color: rgba(138, 43, 43, 0.7);
    border-radius: 4px;
    color: var(--parchment);
}

.grade {
    flex-grow: 1;
    flex-direction: row;
}

.slot {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px;
    padding: 16px 14px;
    align-items: center;
}

.slot-vazio {
    justify-content: center;
    background-color: rgba(29, 34, 48, 0.45);
}

.numero-slot {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/VT323-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 24px;
    letter-spacing: 1px;
    color: var(--parchment-dim);
}

/* O balão do boneco (lista-personagens.tsx): o mesmo da criação e da ficha, menor. */
.retrato {
    width: 108px;
    height: 108px;
    margin: 8px 0 6px 0;
    align-items: center;
    justify-content: center;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 54px;
}

.nome {
    font-size: 26px;
    color: var(--gold-bright);
    white-space: normal;
    -unity-text-align: middle-center;
}

.classe {
    font-size: 17px;
    color: var(--parchment-dim);
    -unity-text-align: middle-center;
}

.numeros {
    flex-direction: row;
    margin: 8px 0;
}

.numero {
    align-items: center;
    margin: 0 14px;
}

.valor {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/VT323-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 36px;
    color: var(--parchment);
}

.chave {
    font-size: 14px;
    color: var(--parchment-dim);
}

.atualizado {
    margin-bottom: 10px;
    font-size: 13px;
    white-space: normal;
    color: var(--parchment-dim);
    -unity-text-align: middle-center;
}

.unity-button.botao-slot {
    margin-top: auto;
    font-size: 17px;
}

/* JOGAR e "Apagar" no pé do cartão; a pergunta de apagar fica no mesmo lugar, sem janela por cima. */
.rodape-do-slot {
    margin-top: auto;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.rodape-do-slot .unity-button.botao-slot {
    margin-top: 0;
}

.rodape-do-slot .unity-button.link {
    margin-left: 12px;
}

.pergunta-do-slot {
    margin-top: auto;
    margin-bottom: 6px;
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.unity-button.link-perigo {
    margin-left: 0;
    color: var(--ember);
    border-color: rgba(192, 83, 47, 0.6);
}

/* ---------- aviso rápido e véu das transições ---------- */

.aviso {
    position: absolute;
    left: 50%;
    bottom: 40px;
    translate: -50% 0;
    padding: 10px 18px;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
    font-size: 18px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.aviso.escondido {
    opacity: 0;
}

.veu {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 1;
}

/* ---------- jogo: o mapa na tela toda, e por cima dele os botões, o herói e o que fala do lugar ---------- */

.jogo {
    background-color: #05060a;
}

/* A textura da cena tem a proporção do palco (TelaDeJogo.AjustarPalco): na cidade o mapa enche a tela; na
   masmorra a sala (9 × 9) fica no meio, com o escuro dos lados. */
.palco {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #05060a;
    -unity-background-scale-mode: scale-to-fit;
    overflow: hidden;
}

/* A área da luta no meio do palco (o tamanho sai do código, na proporção 9 × 7 em que a luta foi afinada). */
.area-da-luta {
    position: absolute;
}

.base-do-joystick {
    position: absolute;
    width: 112px;
    height: 112px;
    margin-left: -56px;
    margin-top: -56px;
    border-radius: 56px;
    border-width: 2px;
    border-color: rgba(236, 223, 192, 0.45);
    background-color: rgba(16, 18, 26, 0.35);
}

.alavanca-do-joystick {
    position: absolute;
    left: 31px;
    top: 31px;
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background-color: rgba(232, 198, 90, 0.75);
}

.base-do-joystick.escondido,
.dica-do-joystick.escondido {
    display: none;
}

.dica-do-joystick {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    font-size: 16px;
    color: rgba(236, 223, 192, 0.7);
    -unity-text-align: middle-center;
}

/* Em cima à esquerda: os botões e o salvamento. */
.topo-do-jogo {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 10px;
    flex-direction: row;
    align-items: flex-start;
}

/* Na luta a sala ocupa a altura toda, com os nomes dos monstros no alto: os botões descem em coluna pelo escuro
   da esquerda (a classe sai do TelaDeJogo). */
.em-luta .acoes-do-jogo {
    flex-direction: column;
}

/* Embaixo à esquerda: nome, nível e as duas barras. */
.resumo-do-heroi {
    position: absolute;
    left: 12px;
    bottom: 10px;
    width: 250px;
    padding: 8px 12px 10px 12px;
    background-color: rgba(16, 18, 26, 0.78);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
}

/* À direita: o minimapa (só na masmorra), o lugar (na chegada), a pergunta, o aviso e o recado, um embaixo do
   outro. */
.avisos-do-jogo {
    position: absolute;
    right: 12px;
    top: 10px;
    width: 30%;
    max-width: 400px;
    align-items: stretch;
}

.avisos-do-jogo .minimapa {
    align-self: flex-end;
    margin-bottom: 6px;
}

.avisos-do-jogo .painel {
    background-color: rgba(16, 18, 26, 0.86);
}

.caixa-do-lugar {
    padding: 10px 14px 6px 14px;
    margin-bottom: 6px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.caixa-do-lugar.apagando {
    opacity: 0;
}

.caixa-do-lugar.escondida {
    display: none;
}

.linha-do-nome {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 4px;
}

.nome-do-heroi {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/Alkhemikal.ttf");
    -unity-font-definition: initial;
    font-size: 26px;
    color: var(--gold-bright);
    margin-right: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nivel-do-heroi {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/VT323-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 22px;
    color: var(--parchment-dim);
}

/* A barra curta do site: o rótulo e o número numa linha, a trilha fina embaixo. */
.barra {
    margin-top: 4px;
}

.rotulo-da-barra {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2px;
}

.nome-da-barra {
    font-size: 15px;
    color: var(--parchment-dim);
}

.trilho {
    height: 8px;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
    overflow: hidden;
}

.enchimento {
    height: 100%;
}

.enchimento.vida {
    background-color: #b8402f;
}

.enchimento.mana {
    background-color: #3f6fb5;
}

.numero-da-barra {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/VT323-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 19px;
    -unity-text-align: lower-right;
}

/* O minimapa: as cores e a neblina do site (jogo.module.css). */
.minimapa {
    flex-shrink: 0;
    flex-direction: column;
    padding: 5px;
    background-color: rgba(5, 6, 10, 0.86);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
}

.fileira-do-minimapa {
    flex-direction: row;
}

.celula {
    width: 22px;
    height: 22px;
    margin: 1px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.celula-vazia {
    background-color: rgba(0, 0, 0, 0);
}

.celula-desconhecida {
    background-color: rgba(255, 255, 255, 0.03);
    border-color: var(--line);
}

.celula-conhecida {
    background-color: var(--panel-2);
    border-color: var(--line);
    opacity: 0.6;
}

.celula-visitada {
    background-color: var(--panel-2);
    border-color: var(--line);
}

.celula-aqui {
    border-width: 2px;
    border-color: var(--gold-bright);
    opacity: 1;
}

.celula-esgotada {
    opacity: 0.4;
}

.celula-aqui.celula-esgotada {
    opacity: 1;
}

.arte-da-celula {
    width: 16px;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
}

.icone-da-celula {
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.lugar {
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/Alkhemikal.ttf");
    -unity-font-definition: initial;
    font-size: 24px;
    color: var(--gold-bright);
    white-space: normal;
    margin-bottom: 4px;
}

.narracao {
    margin-bottom: 4px;
}

/* A barra de rolagem fina, sem as setas da Unity: a narração e as janelas rolam pelo dedo ou pela roda. */
.rolagem-fina .unity-scroller--vertical {
    width: 6px;
    margin-left: 4px;
}

.rolagem-fina .unity-scroller__low-button,
.rolagem-fina .unity-scroller__high-button {
    display: none;
}

/* O slider padrão tem 24 px e transbordava do scroller de 6 px: na narração caía fora da tela, mas entre
   as colunas da mochila virava uma faixa dourada. */
.rolagem-fina .unity-scroller--vertical > .unity-scroller__slider,
.rolagem-fina .unity-scroller--vertical .unity-base-slider__input,
.rolagem-fina .unity-scroller--vertical .unity-base-slider__drag-container {
    margin: 0;
    width: 6px;
    min-width: 6px;
}

.rolagem-fina .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 0;
    border-radius: 3px;
}

.rolagem-fina .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--line);
    border-width: 0;
    border-radius: 3px;
}

.rolagem-fina .unity-scroller--horizontal {
    display: none;
}

.linha-da-narracao {
    font-size: 17px;
    white-space: normal;
    margin-bottom: 6px;
}

.pistas-das-portas {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/VT323-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 19px;
    color: var(--parchment-dim);
    white-space: normal;
}

.caixa,
.recado {
    flex-direction: row;
    padding: 10px 12px;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.caixa.escondida,
.recado.escondida {
    display: none;
}

.icone-da-caixa {
    font-size: 30px;
    margin-right: 10px;
    -unity-text-align: upper-center;
}

.corpo-da-caixa,
.corpo-do-recado {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.titulo-da-caixa,
.titulo-do-recado {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/PixelifySans-SemiBold.ttf");
    -unity-font-definition: initial;
    font-size: 18px;
    color: var(--gold-bright);
    white-space: normal;
    margin-bottom: 2px;
}

.texto-da-caixa,
.texto-do-recado {
    font-size: 16px;
    white-space: normal;
}

.escolhas-da-caixa {
    flex-direction: row;
    margin-top: 8px;
}

.escolhas-da-caixa.escondida {
    display: none;
}

.unity-button.botao-pequeno {
    padding: 12px 28px 15px 22px;
    margin-right: 8px;
    margin-bottom: 6px;
    font-size: 16px;
    letter-spacing: 1px;
}

.unity-button.fechar-recado {
    border-bottom-width: 0;
    font-size: 24px;
    padding: 0 4px;
    align-self: flex-start;
}

.acoes-do-jogo {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
    align-items: flex-start;
}

.estado-do-salvamento {
    font-size: 14px;
    color: var(--parchment-dim);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--contorno);
    margin-left: 4px;
    margin-top: 12px;
    flex-shrink: 0;
}

.estado-do-salvamento.falha {
    color: var(--ember);
}

.sobre-o-jogo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(5, 6, 10, 0.72);
    align-items: center;
    justify-content: center;
}

.janela {
    width: 640px;
    max-height: 92%;
    padding: 20px 24px 16px 24px;
}

.titulo-da-janela {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/Alkhemikal.ttf");
    -unity-font-definition: initial;
    font-size: 28px;
    color: var(--gold-bright);
    margin-bottom: 10px;
    white-space: normal;
}

.conteudo-da-janela {
    flex-shrink: 1;
    margin-bottom: 12px;
}

.botoes-da-janela {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.paragrafo-da-janela {
    font-size: 17px;
    white-space: normal;
    margin-bottom: 8px;
}

.subtitulo-da-janela {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/PixelifySans-SemiBold.ttf");
    -unity-font-definition: initial;
    font-size: 17px;
    color: var(--parchment-dim);
    margin-top: 4px;
    margin-bottom: 6px;
}

.opcoes-da-janela {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

/* A opção escolhida (masmorra, dificuldade, andar): a borda dourada do botão forte. */
.unity-button.botao-escolhido {
    border-color: var(--gold-bright);
    color: var(--gold-bright);
}

.carregando-jogo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ink);
    font-size: 22px;
    -unity-text-align: middle-center;
}

.carregando-jogo.escondido {
    display: none;
}

/* ---------- a luta em tempo real (TelaDeJogo.Luta.cs) ---------- */
/* Por cima da luta em primeira pessoa: o botão de ataque no canto de baixo à direita (o polegar direito), os poderes
   e a poção em arco em volta dele, o evento da arma no palco dos monstros e os números que sobem. O polegar esquerdo
   continua no joystick do palco, que move o coração. */

.hud-da-luta {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-da-luta.escondido,
.menu-de-itens.escondido,
.dica-do-evento.escondido {
    display: none;
}

.numeros-da-luta {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.numero-da-luta {
    position: absolute;
    translate: -50% 0;
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/VT323-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 30px;
    color: var(--parchment);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--contorno);
    white-space: nowrap;
}

.numero-critico {
    font-size: 38px;
    color: var(--gold-bright);
}

.numero-cura {
    color: #7fd17a;
}

.numero-erro {
    font-size: 24px;
    color: var(--parchment-dim);
}

/* o escudo do vigor (a Encantadora) apanhando no lugar da vida */
.numero-escudo {
    color: #8fc8ff;
}

.avisos-da-luta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 132px;
    align-items: center;
}

.aviso-da-luta,
.diario-da-luta {
    margin-top: 4px;
    padding: 3px 10px;
    border-radius: 4px;
    background-color: rgba(16, 18, 26, 0.78);
    font-size: 17px;
    color: var(--parchment);
    white-space: normal;
    max-width: 80%;
    -unity-text-align: middle-center;
}

.diario-da-luta {
    color: var(--gold-bright);
}

.evento-da-arma {
    position: absolute;
}

/* A letra do cajado no PC, no meio do aro (o tamanho e a cor vêm do código). */
.letra-do-evento {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/PixelifySans-SemiBold.ttf");
    -unity-font-definition: initial;
    color: rgb(236, 223, 192);
}

.dica-do-evento {
    position: absolute;
    left: 50%;
    top: 2px;
    translate: -50% 0;
    padding: 1px 10px;
    border-radius: 4px;
    background-color: rgba(16, 18, 26, 0.88);
    font-size: 16px;
    color: var(--parchment);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.botoes-da-luta {
    position: absolute;
    right: 14px;
    bottom: 14px;
    width: 220px;
    height: 220px;
}

/* Os botões em volta do ataque têm a posição calculada no código (o arco). */
.poderes-da-luta {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.unity-button.botao-da-luta.botao-em-volta {
    position: absolute;
    margin: 0;
}

.escondido-na-luta {
    display: none;
}

.unity-button.botao-da-luta {
    width: 62px;
    height: 62px;
    margin: 8px 0 0 0;
    padding: 0;
    border-radius: 31px;
    border-width: 2px;
    border-color: rgba(201, 162, 39, 0.75);
    background-color: rgba(29, 34, 48, 0.9);
    font-size: 28px;
    -unity-text-align: middle-center;
    overflow: hidden;
}

.unity-button.botao-da-luta:hover {
    background-color: rgba(36, 42, 58, 0.95);
}

.unity-button.botao-da-luta.sem-mana {
    opacity: 0.45;
}

.icone-do-poder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.custo-do-poder {
    position: absolute;
    right: 6px;
    bottom: 2px;
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/VT323-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 17px;
    color: #9fc2ff;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--contorno);
}

.espera-do-poder {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0.6);
}

.botao-de-ataque {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 108px;
    height: 108px;
    border-radius: 54px;
    border-width: 3px;
    border-color: var(--gold);
    background-color: rgba(29, 34, 48, 0.92);
    align-items: center;
    justify-content: center;
}

.botao-de-ataque.apertado {
    scale: 0.94 0.94;
    border-color: var(--gold-bright);
}

.botao-de-ataque.esperando {
    opacity: 0.6;
}

.icone-do-ataque {
    width: 66px;
    height: 66px;
    -unity-background-scale-mode: scale-to-fit;
}

.emoji-do-ataque {
    position: absolute;
    font-size: 46px;
    -unity-text-align: middle-center;
}

.menu-de-itens {
    position: absolute;
    right: 240px;
    bottom: 14px;
    width: 280px;
    padding: 8px 10px;
}

.titulo-do-menu-de-itens {
    font-size: 18px;
    color: var(--gold-bright);
    margin-bottom: 4px;
}

.unity-button.item-do-menu {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
    padding: 4px 6px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    font-size: 17px;
    color: var(--parchment);
    -unity-text-align: middle-left;
}

.unity-button.item-do-menu:hover {
    background-color: rgba(201, 162, 39, 0.15);
    color: var(--gold-bright);
}

.icone-do-item-do-menu {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- a luta em primeira pessoa (PalcoDaLuta.cs) ---------- */
/* Teste pedido pelo usuário em 2026-10-17: o palco do combate do site (o cenário do lugar, os monstros de frente com a
   placa em cima) e embaixo a caixa preta do Undertale, com o coração. As cores do cenário vêm do tema do lugar, no
   código; a posição e o tamanho da caixa também (a proporção é a da engine). */

.palco-da-luta {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

/* A luta no mapa (2026-10-30): a sala de verdade aparece por trás (a cena a enquadra); os monstros em pé nela, cada um
   na casa dele (posição e tamanho saem do código), e as placas numa coluna ao lado. */
.figuras-da-luta {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.placas-da-luta {
    position: absolute;
    flex-direction: column;
    justify-content: flex-start;
}

.lutador {
    flex-shrink: 1;
    margin-bottom: 6px;
}

.placa-da-luta {
    width: 100%;
    padding: 5px 8px 6px 8px;
    background-color: rgba(16, 18, 26, 0.78);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
    align-items: center;
}

.lutador-chefe .placa-da-luta {
    border-color: var(--gold);
}

.lutador-alvo .placa-da-luta {
    border-width: 2px;
    border-color: var(--gold-bright);
}

.nome-do-lutador {
    font-size: 20px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    white-space: normal;
}

.subtitulo-do-lutador {
    font-size: 14px;
    color: var(--parchment-dim);
}

.trilho-da-luta {
    width: 100%;
    height: 8px;
    margin-top: 3px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 2px;
    overflow: hidden;
}

.vida-da-luta {
    height: 100%;
    background-color: var(--ember);
}

.vida-do-lutador {
    -unity-font: url("project://database/Assets/RPGLegend/UI/Fontes/VT323-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 18px;
    color: var(--parchment-dim);
}

.marcadores-da-luta {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.marcador-da-luta {
    margin: 2px;
    padding: 0 6px;
    font-size: 13px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 8px;
    background-color: rgba(16, 18, 26, 0.6);
}

.vez-do-lutador {
    font-size: 14px;
    color: #ff9f6b;
}

.corpo-do-lutador {
    position: absolute;
    align-items: center;
    translate: -50% -100%;
}

.placas-enxutas .placa-da-luta {
    padding: 3px 6px 4px 6px;
}

.placas-enxutas .nome-do-lutador {
    font-size: 16px;
}

.placas-enxutas .subtitulo-do-lutador,
.placas-enxutas .vez-do-lutador {
    font-size: 12px;
}

.mira-do-lutador {
    height: 26px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.figura-do-lutador {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.lutador-avisando .figura-do-lutador {
    scale: 1.08 1.08;
}

.sombra-do-lutador {
    height: 10px;
    margin-top: -10px;
    border-radius: 45px;
    background-color: rgba(0, 0, 0, 0.35);
}

/* Quem caiu fica no lugar, apagado, até a luta acabar (como no site); o corpo apaga no código, junto com o mergulho. */
.lutador-caido .placa-da-luta {
    opacity: 0.38;
}

.aliados-da-luta {
    position: absolute;
    left: 8px;
    align-items: center;
}

.aliado-na-luta {
    width: 54px;
    margin-bottom: 6px;
    padding: 3px;
    align-items: center;
    background-color: rgba(16, 18, 26, 0.72);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
}

.aliado-na-mira {
    border-width: 2px;
    border-color: #e04040;
}

.aliado-caido {
    opacity: 0.38;
}

.icone-do-aliado {
    font-size: 26px;
    -unity-text-align: middle-center;
}

.trilho-do-aliado {
    width: 100%;
    height: 5px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 2px;
    overflow: hidden;
}

.vida-do-aliado {
    height: 100%;
    background-color: #5fa85a;
}

/* A caixa do Undertale: preta, de borda branca. O que vai dentro é desenhado no código. */
.caixa-da-luta {
    position: absolute;
    background-color: #000000;
    border-width: 3px;
    border-color: #ffffff;
    overflow: hidden;
}

.tinta-da-caixa {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.mergulho-na-caixa {
    position: absolute;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* O chefe final chama 4 lacaios (ChefeFinal): até cinco monstros no palco, menores e com a placa enxuta. */
.grupo-de-cinco .figura-do-lutador {
    font-size: 64px;
}

.grupo-de-cinco .lutador-chefe .figura-do-lutador {
    font-size: 100px;
}

.grupo-de-cinco .placa-da-luta {
    width: 98%;
    padding: 3px 3px 4px 3px;
}

.grupo-de-cinco .nome-do-lutador {
    font-size: 15px;
}

.grupo-de-cinco .subtitulo-do-lutador,
.grupo-de-cinco .vez-do-lutador {
    font-size: 12px;
}

.grupo-de-cinco .marcador-da-luta {
    font-size: 11px;
}
