<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/RPGLegend/UI/Tema.uss" />
    <Style src="project://database/Assets/RPGLegend/UI/Telas.uss" />
    <ui:VisualElement name="raiz" class="raiz" picking-mode="Ignore">

        <!-- A entrada fica por cima da cena da porta: o cartão à direita e o "toque para entrar" embaixo. -->
        <ui:VisualElement name="entrada" class="entrada" picking-mode="Ignore">
            <ui:VisualElement name="cartao-entrada" class="painel cartao-entrada escondido">
                <ui:VisualElement class="moldura" picking-mode="Ignore" />
                <ui:Label text="RPG Legend" class="marca" />
                <ui:Label name="titulo-entrada" text="Entrar na conta" class="titulo" />
                <ui:TextField name="campo-usuario" label="Usuário ou e-mail" class="campo" />
                <ui:TextField name="campo-email" label="E-mail" class="campo" />
                <ui:TextField name="campo-senha" label="Senha" password="true" class="campo" />
                <ui:Label name="erro-entrada" class="erro" />
                <ui:VisualElement class="acoes">
                    <ui:Button name="botao-entrar" text="ENTRAR" class="botao" />
                    <ui:Button name="botao-alternar" text="Criar uma conta" class="link" />
                </ui:VisualElement>
                <ui:Button name="botao-esqueci" text="Esqueci minha senha" class="link link-direita" />
            </ui:VisualElement>
            <ui:Label name="toque-para-entrar" text="Toque para entrar" class="toque escondido" />
        </ui:VisualElement>

        <!-- Menu principal: o brasão à esquerda, os três botões de pedra à direita. -->
        <ui:VisualElement name="menu" class="tela menu oculto">
            <ui:VisualElement name="brasao" class="brasao" />
            <ui:VisualElement class="coluna-menu">
                <ui:Label name="ola" class="ola" />
                <ui:Button name="botao-jogar" text="JOGAR" class="botao botao-menu botao-forte" />
                <ui:Button name="botao-config" text="CONFIGURAÇÕES" class="botao botao-menu" />
                <ui:Button name="botao-loja" text="LOJA" class="botao botao-menu" />
            </ui:VisualElement>
            <ui:Button name="botao-sair" text="Sair da conta" class="link canto" />
            <!-- Obrigatório: a licença CC BY 4.0 da fonte dos títulos pede crédito visível (ver UI/Fontes). -->
            <ui:Label name="credito" text="Fonte dos títulos: Alkhemikal, de jeti, sob a licença CC BY 4.0." class="credito" />
        </ui:VisualElement>

        <!-- Personagens: os até 4 slots da conta, lidos da nuvem. -->
        <ui:VisualElement name="personagens" class="tela personagens oculto">
            <ui:VisualElement class="cabecalho">
                <ui:VisualElement class="cabecalho-textos">
                    <ui:Label text="Seus personagens" class="titulo-tela" />
                    <ui:Label text="Cada slot guarda um progresso separado na nuvem." class="subtitulo" />
                </ui:VisualElement>
                <ui:Button name="botao-voltar" text="VOLTAR AO MENU" class="botao" />
            </ui:VisualElement>
            <ui:Label name="estado-personagens" class="estado" />
            <ui:VisualElement name="grade" class="grade" />
        </ui:VisualElement>

        <!-- Configurações (painel-configuracoes.tsx): o som, que é deste aparelho, e os créditos. -->
        <ui:VisualElement name="configuracoes" class="tela configuracoes oculto">
            <ui:VisualElement class="cabecalho">
                <ui:VisualElement class="cabecalho-textos">
                    <ui:Label text="Configurações" class="titulo-tela" />
                    <ui:Label text="Valem para este aparelho." class="subtitulo" />
                </ui:VisualElement>
                <ui:Button name="botao-voltar-config" text="VOLTAR AO MENU" class="botao" />
            </ui:VisualElement>
            <ui:ScrollView class="corpo-da-config rolagem-fina" horizontal-scroller-visibility="Hidden">
                <ui:Label text="Som" class="titulo-da-secao" />
                <ui:VisualElement class="linha-da-config">
                    <ui:Label text="Som do jogo" class="rotulo-da-config" />
                    <ui:Button name="botao-som" class="botao botao-pequeno" />
                </ui:VisualElement>
                <ui:VisualElement class="campo-da-config">
                    <ui:VisualElement class="linha-da-config">
                        <ui:Label text="Volume geral" class="rotulo-da-config" />
                        <ui:Label name="valor-do-volume" class="valor-da-config" />
                    </ui:VisualElement>
                    <ui:SliderInt name="volume-geral" low-value="0" high-value="100" class="deslizante" />
                    <ui:Label text="Vale pra todo o som do jogo." class="dica-da-config" />
                </ui:VisualElement>
                <ui:VisualElement class="campo-da-config">
                    <ui:VisualElement class="linha-da-config">
                        <ui:Label text="Efeitos sonoros" class="rotulo-da-config" />
                        <ui:Label name="valor-dos-efeitos" class="valor-da-config" />
                    </ui:VisualElement>
                    <ui:SliderInt name="volume-dos-efeitos" low-value="0" high-value="100" class="deslizante" />
                    <ui:Label text="Golpe, moeda, porta, nível. Abaixa só eles." class="dica-da-config" />
                </ui:VisualElement>
                <ui:Button name="botao-testar-som" text="TESTAR EFEITO" class="botao botao-pequeno botao-testar" />
                <ui:Label text="A preferência é deste aparelho, não da conta: quem joga no celular e no computador ajusta cada um do seu jeito." class="nota-da-config" />
                <!-- Obrigatório: a licença CC BY 4.0 da fonte dos títulos pede crédito visível (ver UI/Fontes). -->
                <ui:Label text="Créditos" class="titulo-da-secao" />
                <ui:Label text="Fonte dos títulos: Alkhemikal, de jeti, sob a licença CC BY 4.0." class="nota-da-config" />
                <ui:VisualElement class="links-da-config">
                    <ui:Button name="link-da-fonte" text="Página da fonte" class="link" />
                    <ui:Button name="link-da-licenca" text="Licença CC BY 4.0" class="link" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- Loja (painel-loja.tsx): pets, molduras e cores de nome, pagos com o ouro de um personagem. -->
        <ui:VisualElement name="loja" class="tela loja oculto">
            <ui:VisualElement class="cabecalho">
                <ui:VisualElement class="cabecalho-textos">
                    <ui:Label text="Loja" class="titulo-tela" />
                    <ui:Label text="Pets, molduras e cores de nome. O ouro sai do personagem." class="subtitulo" />
                </ui:VisualElement>
                <ui:Button name="botao-voltar-loja" text="VOLTAR AO MENU" class="botao" />
            </ui:VisualElement>
            <ui:Label name="estado-da-loja" class="estado" />
            <ui:ScrollView name="corpo-da-loja" class="corpo-da-loja rolagem-fina" horizontal-scroller-visibility="Hidden" />
        </ui:VisualElement>

        <!-- Novo personagem (formulario-criacao.tsx): a prévia ao lado das escolhas, nome, raça e cabelo. -->
        <ui:VisualElement name="criacao" class="tela criacao oculto">
            <ui:VisualElement class="cabecalho">
                <ui:VisualElement class="cabecalho-textos">
                    <ui:Label text="Novo personagem" class="titulo-tela" />
                    <ui:Label name="slot-da-criacao" class="subtitulo" />
                </ui:VisualElement>
                <ui:Button name="botao-voltar-criacao" text="VOLTAR" class="botao" />
            </ui:VisualElement>
            <ui:VisualElement class="corpo-da-criacao">
                <ui:VisualElement class="previa-da-criacao">
                    <ui:VisualElement name="balao-da-criacao" class="balao-da-criacao" />
                    <ui:Label name="legenda-da-criacao" class="legenda-da-criacao" />
                </ui:VisualElement>
                <ui:ScrollView name="formulario-da-criacao" class="formulario-da-criacao rolagem-fina" horizontal-scroller-visibility="Hidden">
                    <ui:TextField name="nome-da-criacao" label="Nome do herói" max-length="20" class="campo campo-da-criacao" />
                    <ui:Label text="Raça" class="titulo-da-secao" />
                    <ui:VisualElement name="racas-da-criacao" class="grade-de-cartas" />
                    <ui:VisualElement name="secao-do-cabelo">
                        <ui:Label text="Cabelo" class="titulo-da-secao" />
                        <ui:VisualElement name="cabelos-da-criacao" class="grade-de-cartas" />
                    </ui:VisualElement>
                    <ui:Button name="botao-comecar" text="COMEÇAR AVENTURA" class="botao botao-forte botao-comecar" />
                    <ui:Label text="Você começa como Aprendiz. A classe e o primeiro poder vêm do Treinamento de Guilda, na cidade — sem ele, o portão da masmorra não abre." class="dica-da-criacao" />
                    <ui:Label name="erro-da-criacao" class="erro" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- O jogo: o mapa na tela toda, e por cima dele os botões (em cima), o herói (embaixo à esquerda) e o que
             fala do lugar (à direita, só quando chega; decisão do usuário em 2026-10-23, só no app). -->
        <ui:VisualElement name="jogo" class="tela jogo oculto">
            <ui:VisualElement name="palco" class="palco">
                <!-- A área da luta (9 × 7, a proporção em que ela foi afinada) no meio do palco. -->
                <ui:VisualElement name="area-da-luta" class="area-da-luta" picking-mode="Ignore" />
                <ui:VisualElement name="base-do-joystick" class="base-do-joystick escondido" picking-mode="Ignore">
                    <ui:VisualElement name="alavanca-do-joystick" class="alavanca-do-joystick" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="dica-do-joystick" text="Arraste o dedo na sala para andar" class="dica-do-joystick" picking-mode="Ignore" />
                <!-- O pet da conta no canto da tela (bicho-de-estimacao.tsx); tocar faz carinho. -->
                <ui:Button name="bichinho" />
            </ui:VisualElement>
            <ui:VisualElement name="topo-do-jogo" class="topo-do-jogo" picking-mode="Ignore">
                <ui:VisualElement class="acoes-do-jogo" picking-mode="Ignore">
                    <ui:Button name="botao-mochila" text="MOCHILA" class="botao botao-pequeno" />
                    <ui:Button name="botao-diario" text="DIÁRIO" class="botao botao-pequeno" />
                    <ui:Button name="botao-guia" text="GUIA" class="botao botao-pequeno" />
                    <ui:Button name="botao-sair-do-jogo" text="SAIR" class="botao botao-pequeno" />
                    <ui:Label name="estado-do-salvamento" class="estado-do-salvamento" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- O resumo curto do site (painel-heroi.tsx): nome e nível, e as duas barras uma embaixo da outra. -->
            <ui:VisualElement name="resumo-do-heroi" class="resumo-do-heroi">
                <ui:VisualElement class="linha-do-nome">
                    <ui:Label name="nome-do-heroi" class="nome-do-heroi" />
                    <ui:Label name="nivel-do-heroi" class="nivel-do-heroi" />
                    <!-- O cartão de guilda inteiro, como o botão "Ficha" da faixa do site no celular. -->
                    <ui:Button name="botao-ficha" text="Ficha" class="link botao-ficha" />
                </ui:VisualElement>
                <ui:VisualElement class="barra">
                    <ui:VisualElement class="rotulo-da-barra">
                        <ui:Label text="Vida" class="nome-da-barra" />
                        <ui:Label name="numero-da-vida" class="numero-da-barra" />
                    </ui:VisualElement>
                    <ui:VisualElement class="trilho"><ui:VisualElement name="vida" class="enchimento vida" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="barra">
                    <ui:VisualElement class="rotulo-da-barra">
                        <ui:Label text="Mana" class="nome-da-barra" />
                        <ui:Label name="numero-da-mana" class="numero-da-barra" />
                    </ui:VisualElement>
                    <ui:VisualElement class="trilho"><ui:VisualElement name="mana" class="enchimento mana" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- À direita: o que fala do lugar (aparece na chegada e some sozinho; tocar fecha), a pergunta de SIM/NÃO
                 e os avisos, que ficam até a resposta, e o recado, que fica até o ×. -->
            <ui:VisualElement name="avisos-do-jogo" class="avisos-do-jogo" picking-mode="Ignore">
                <ui:VisualElement name="minimapa" class="minimapa" picking-mode="Ignore" />
                <ui:VisualElement name="caixa-do-lugar" class="painel caixa-do-lugar escondida">
                    <ui:Label name="lugar" class="lugar" />
                    <ui:VisualElement name="narracao" class="narracao" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="caixa" class="painel caixa escondida">
                    <ui:Label name="icone-da-caixa" class="icone-da-caixa" />
                    <ui:VisualElement class="corpo-da-caixa">
                        <ui:Label name="titulo-da-caixa" class="titulo-da-caixa" />
                        <ui:Label name="texto-da-caixa" class="texto-da-caixa" />
                        <ui:VisualElement name="escolhas-da-caixa" class="escolhas-da-caixa">
                            <ui:Button name="botao-sim" text="SIM" class="botao botao-pequeno" />
                            <ui:Button name="botao-nao" text="NÃO" class="botao botao-pequeno" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="recado" class="painel recado escondida">
                    <ui:VisualElement class="corpo-do-recado">
                        <ui:Label name="titulo-do-recado" class="titulo-do-recado" />
                        <ui:Label name="texto-do-recado" class="texto-do-recado" />
                    </ui:VisualElement>
                    <ui:Button name="fechar-recado" text="×" class="link fechar-recado" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Por cima do jogo: as telas de sala (loja, conversa…), o diário e a confirmação de saída. -->
            <ui:VisualElement name="sobre-o-jogo" class="sobre-o-jogo oculto">
                <ui:VisualElement name="janela" class="painel janela">
                    <ui:VisualElement class="moldura" picking-mode="Ignore" />
                    <ui:VisualElement class="cabecalho-da-janela">
                        <ui:Label name="titulo-da-janela" class="titulo-da-janela" />
                        <ui:Label name="ouro-da-janela" class="ouro-da-janela" />
                    </ui:VisualElement>
                    <!-- A última resposta da tela ("Você compra…", "Você equipa…"), como a linha do log do site. -->
                    <ui:Label name="linha-da-janela" class="linha-da-janela" />
                    <ui:ScrollView name="conteudo-da-janela" class="conteudo-da-janela rolagem-fina" horizontal-scroller-visibility="Hidden" />
                    <!-- Mochila, loja e guilda: colunas que rolam cada uma por dentro, como no site. -->
                    <ui:VisualElement name="colunas-da-janela" class="colunas-da-janela" />
                    <ui:VisualElement name="botoes-da-janela" class="botoes-da-janela" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="carregando-jogo" text="Carregando progresso…" class="carregando-jogo" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:Label name="aviso" class="aviso escondido" picking-mode="Ignore" />
        <ui:VisualElement name="veu" class="veu" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
